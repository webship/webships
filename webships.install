<?php

/**
 * @file
 * Install and uninstall functions for the Webships installer.
 */

use Drupal\user\UserInterface;

/**
 * Implements hook_install().
 *
 * The Webships installer enables no modules and ships no configuration of its
 * own: the site template chosen during the install decides what the site has.
 * Only the few settings that must be in place before any site template is
 * applied belong here.
 *
 * @see system_install()
 */
function webships_install() {

  // Restrict user registration to admin role creation.
  \Drupal::configFactory()
    ->getEditable('user.settings')
    ->set('register', UserInterface::REGISTER_ADMINISTRATORS_ONLY)
    ->save(TRUE);

  // Use the admin theme when editing content, front end and back end alike.
  \Drupal::configFactory()
    ->getEditable('node.settings')
    ->set('use_admin_theme', TRUE)
    ->save(TRUE);

  // Rebuild the router, to ensure the menu links are valid.
  \Drupal::service('router.builder')->rebuildIfNeeded();

}
